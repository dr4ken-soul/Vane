# Vane contracts environment.
# Copy to contracts/.env and fill in. Never commit the filled file.

SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
DEPLOYER_PRIVATE_KEY=
ETHERSCAN_API_KEY=
TREASURY_WALLET_ADDRESS=
PROTOCOL_FEE_WEI=0

# VaneMeterOracle address used by scripts/seedCleanRoot.ts.
VANE_METER_ORACLE_ADDRESS=

# Optional seed overrides. Defaults target the Gebze Organised Industrial Zone.
SEED_LATITUDE=40.80
SEED_LONGITUDE=29.43
SEED_RATED_KW=1200
SEED_METER_NAME=GEBZE-OSB-SOLAR-01
SEED_SUPPLIER_TAX_ID=TR-GEBZE-OSB-7788124

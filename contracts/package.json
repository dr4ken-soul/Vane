{
  "name": "vane-contracts",
  "version": "1.0.0",
  "private": true,
  "description": "Vane Ethereum Sepolia contracts: meter oracle, attestation registry and UltraHonk verifier.",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "deploy": "hardhat run scripts/deploy.ts --network sepolia",
    "deploy:local": "hardhat run scripts/deploy.ts --network localhost",
    "seed": "hardhat run scripts/seedCleanRoot.ts --network sepolia",
    "seed:local": "hardhat run scripts/seedCleanRoot.ts --network localhost",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@openzeppelin/contracts": "5.1.0"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "5.0.0",
    "@types/chai": "4.3.20",
    "@types/mocha": "10.0.10",
    "@types/node": "20.17.6",
    "chai": "4.5.0",
    "dotenv": "16.4.7",
    "ethers": "6.15.0",
    "hardhat": "2.28.0",
    "ts-node": "10.9.2",
    "typescript": "5.6.3"
  }
}

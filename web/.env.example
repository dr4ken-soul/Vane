# Vane web environment.
# Copy to web/.env.local and fill in after deploying the contracts.

NEXT_PUBLIC_CHAIN_ID=11155111
NEXT_PUBLIC_SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Populated from the deploy script output.
NEXT_PUBLIC_HONK_VERIFIER_ADDRESS=
NEXT_PUBLIC_VANE_METER_ORACLE_ADDRESS=
NEXT_PUBLIC_VANE_ATTESTATION_REGISTRY_ADDRESS=

# Public base URL used by shareable /verify/[id] customs links.
NEXT_PUBLIC_APP_URL=http://localhost:3000
